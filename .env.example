# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Supported: openrouter
LLM_PROVIDER=openrouter

# ── OpenRouter ────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_key_here
# Free model — change to any model slug from https://openrouter.ai/models?q=free
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# ── Agent settings ────────────────────────────────────────────────────────────
# Minimum Laya confidence to act on a routing decision (0.0–1.0)
ROUTING_CONFIDENCE_THRESHOLD=0.60
# Device for Laya inference: cpu | cuda | mps
LAYA_DEVICE=cpu
